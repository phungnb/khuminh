# Kết nối của ứng dụng: role khuminh_app (chịu RLS). Không dùng tài khoản chủ bảng ở đây.
DATABASE_URL_APP=postgres://khuminh_app:change-me@localhost:5432/khuminh
# Chỉ dùng khi chạy migration: tài khoản sở hữu bảng.
DATABASE_URL=postgres://khuminh_owner:owner@localhost:5432/khuminh
# Địa chỉ công khai để tạo link hóa đơn gửi người thuê.
APP_URL=http://localhost:3000
